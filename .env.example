# Backend base URL, ending in /api. Set this in Vercel → Project → Settings → Environment Variables
# (it is read at BUILD time, so redeploy after changing it).
# This is YOUR PORTFOLIO backend, not the EVO Codes backend.
VITE_API_URL=https://your-portfolio-api.onrender.com/api

# Leave VITE_API_URL empty (or unset) to run without a backend: the site then uses the content in src/data.
